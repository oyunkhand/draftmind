# ---- Data source -----------------------------------------------------------
# auto  = use GRID when GRID_API_KEY is set (falls back to sample data on error), otherwise sample
# sample | grid
DATA_SOURCE=auto
GRID_API_KEY=
# GRID_MAX_SERIES=150

# ---- Optional LLM explanations (app works fully without these) ------------
# LLM_PROVIDER=auto   # auto | anthropic | openai | none
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# ---- Server ----------------------------------------------------------------
# CORS_ORIGINS=*                       # comma-separated, e.g. https://draftmind.vercel.app
# DB_PATH=backend/draftmind.db
# RECENCY_HALF_LIFE_DAYS=45

# ---- Frontend (build time) -------------------------------------------------
# VITE_API_URL=https://draftmind-api.onrender.com   # empty = same origin (/api)
